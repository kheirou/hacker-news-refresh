{
  "manifest_version": 2,
  "name": "Hacker News Refresh",
  "version": "1.0.0",
  "description": "A cleaner, themeable Hacker News.",
  "browser_specific_settings": { "gecko": { "id": "hacker-news-refresh@kheirou.dev", "strict_min_version": "142.0", "data_collection_permissions": { "required": ["none"] } } },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "web_accessible_resources": ["fonts/*"],
  "permissions": ["storage", "https://hacker-news.firebaseio.com/*"],
  "browser_action": { "default_popup": "popup.html", "default_title": "Hacker News Refresh", "default_icon": "icons/icon.svg" },
  "content_scripts": [{
    "matches": ["https://news.ycombinator.com/*"],
    "css": ["content.css"],
    "js": ["defaults.js", "store.js", "ui.js", "bookmarks.js", "newreplies.js", "index.js", "comments.js", "profile.js", "panels.js", "selection.js", "userpop.js", "controls.js", "shell.js", "history.js", "content.js"],
    "run_at": "document_start"
  }]
}
